generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id          String       @id @default(cuid())
  make        String
  model       String
  year        Int
  mileage     Int
  createdAt   DateTime     @default(now())
  inspections Inspection[]
}

model Inspection {
  id        String    @id @default(cuid())
  vehicleId String
  status    String    @default("uploaded")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  photos    Photo[]
  estimate  Estimate?
}

model Photo {
  id           String     @id @default(cuid())
  inspectionId String
  label        String
  filePath     String
  mimeType     String
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model Estimate {
  id                  String     @id @default(cuid())
  inspectionId        String     @unique
  damagedParts        Json
  damageDescriptions  Json
  repairActions       Json
  paintRequired       Boolean
  estimatedLaborHours Float
  confidence          Float
  partsCost           Int
  paintCost           Int
  laborCost           Int
  totalCost           Int
  createdAt           DateTime   @default(now())
  inspection          Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}
