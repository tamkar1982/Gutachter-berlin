# Database connection for Prisma-powered inspection endpoints.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gutachter

# Optional: leave empty to use the demo analysis.
OPENAI_API_KEY=

# Mailjet credentials: fill these only in your local .env or Vercel settings.
MJ_APIKEY_PUBLIC=your-mailjet-api-key
MJ_APIKEY_PRIVATE=your-mailjet-secret-key

# Must be an active, validated sender in your Mailjet account.
CALLBACK_FROM_EMAIL=sender@example.com
CALLBACK_FROM_NAME=SchadenFuchs
